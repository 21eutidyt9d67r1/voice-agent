AZURE_VOICE_AGENTS_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>

# Explicit choices; the sample never falls back to another model automatically.
DIGIT_RECOGNITION_TRANSCRIPTION_MODEL=mai-transcribe-2

# Leave blank for automatic language detection. MAI accepts at most one locale,
# such as en-US or es-ES, not a comma-separated language list.
# With azure-speech, a list such as en-US,es-ES is supported.
DIGIT_RECOGNITION_LANGUAGE=
