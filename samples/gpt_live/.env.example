# Shared by the Python samples in python/ and the browser sample in js/.

# Existing Foundry project with the Voice Agents / GPT Live preview enabled.
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT

# Optional existing agent for python/response_delegation.py and the default browser
# sample. The managed-prompt samples always create two new agents and ignore AGENT_NAME.
AGENT_NAME=

# Sign in with az login. No API keys or manually copied tokens are needed.
# Optional: choose a signed-in subscription without changing the CLI default.
AZURE_SUBSCRIPTION_ID=

# Both required for the managed-prompt samples, or when AGENT_NAME is blank.
# Existing agents use their saved settings.
GPT_LIVE_DEPLOYMENT=YOUR-GPT-LIVE-DEPLOYMENT

# Text deployment: the direct Responses backend, or the model of the prompt agent
# created by the managed-prompt samples.
RESPONSE_DELEGATION_DEPLOYMENT=YOUR-DELEGATION-DEPLOYMENT
