# Existing Foundry project with the Voice Agents / GPT Live preview enabled.
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT

# Optional existing agent for response_delegation.py.
# The managed-prompt sample always creates two new agents and ignores AGENT_NAME.
AGENT_NAME=

# Sign in with az login. No API keys or manually copied tokens are needed.
# Optional: choose a signed-in subscription without changing the CLI default.
AZURE_SUBSCRIPTION_ID=

# Both required for the managed-prompt sample, or when AGENT_NAME is blank in
# response_delegation.py. Existing agents use their saved settings.
GPT_LIVE_DEPLOYMENT=YOUR-GPT-LIVE-DEPLOYMENT

# Text deployment: direct Responses backend in response_delegation.py, or the
# model of the prompt agent created by prompt_agent_delegation.py.
RESPONSE_DELEGATION_DEPLOYMENT=YOUR-DELEGATION-DEPLOYMENT
