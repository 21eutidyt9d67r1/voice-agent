PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
# Actual deployment names in the target project, not model catalog names.
GPT_LIVE_MODEL_DEPLOYMENT=gpt-live-1
RESPONSES_MODEL_DEPLOYMENT=<responses-deployment>
# Same-project connection with category=SipInbound; the connection command creates it if missing.
SIP_CONNECTION_NAME=sip-inbound-sample

# Only needed for the connection preparation command, not Agent or binding commands.
# Copy the project ARM ID (not the account ID or the PROJECT_ENDPOINT URL):
# /subscriptions/<subscription-id>/resourceGroups/<group>/providers/Microsoft.CognitiveServices/accounts/<account>/projects/<project>
PROJECT_RESOURCE_ID=
# New connections default to digest. Leave unset to reuse either mode on an existing connection.
# SIP_AUTH_TYPE=digest
# Fill these locally for a new digest connection; never commit real credentials.
SIP_USERNAME=
SIP_PASSWORD=
# For IP ACL, set SIP_AUTH_TYPE=ip_acl and provide actual public signaling egress IPs/CIDRs.
# SIP_SOURCE_CIDRS=
