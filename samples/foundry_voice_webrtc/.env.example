AZURE_AI_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
# Optional: leave blank to create/reuse webrtc-personalized-hd-demo.
# An existing Agent is not required.
AZURE_VOICE_AGENT_NAME=
# Optional: require the demo's structured inputs for an existing Agent.
# Newly created demo Agents are detected automatically by the UI.
PERSONALIZATION_REQUIRED=false
# Optional destructive UI action, restricted to the configured sample-owned Agent.
# Keep disabled on shared or publicly accessible deployments unless explicitly intended.
ALLOW_AGENT_RECREATE=false
# Agent Service requires Entra ID. Resource API keys do not work here.
# Install Azure CLI, then run az login as the same Windows user as this server.
# No resource API key or application client secret is used.
AZURE_API_VERSION=v1
FOUNDRY_FEATURES=VoiceAgents=V1Preview
PORT=8080
# Optional ICE servers. Supply short-lived TURN credentials for restricted networks.
ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]
